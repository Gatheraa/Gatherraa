# =============================================================================
# Observability stack - Grafana configuration (development-only defaults)
# =============================================================================
# Copy to observability/.env (or export in your shell) and adjust for your
# environment. These variables are interpolated by
# observability/docker-compose.observability.yml and validated at container
# startup by observability/grafana/entrypoint.sh.
#
# The defaults below are STRICTLY for local development. Do not expose the
# stack beyond localhost with any of these values unchanged.

# Mark the stack as development-only. Set to "false" (or unset) for any
# environment that could be reached by others; the entrypoint then refuses to
# run with a weak default password.
GRAFANA_DEV_ONLY=true

# Grafana admin user. Change from the "admin" default in any shared context.
GRAFANA_ADMIN_USER=admin

# Grafana admin password. The "admin" default is development-only; replace it
# with a strong, unique value outside local development.
GRAFANA_ADMIN_PASSWORD=admin
